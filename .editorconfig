root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.swift]
indent_style = space
indent_size = 4
max_line_length = 130
trim_trailing_whitespace = true
xcode_trim_whitespace_on_empty_lines = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
